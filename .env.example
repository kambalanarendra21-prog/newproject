# Main (super) account — full access to settings, users, and all domains
SUPER_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-strong-password

# Session signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-random-hex

# Optional: bind host/port
HOST=0.0.0.0
PORT=8080

# Cloudflare API token with Zone:DNS:Edit on your zones
CLOUDFLARE_API_TOKEN=

# Path to Google OAuth client secrets JSON (Desktop or Web client)
GOOGLE_CREDENTIALS_FILE=/app/data/secrets/credentials.json

# Path to stored Google OAuth tokens (created after first login)
GOOGLE_TOKEN_FILE=/app/data/secrets/token.json
GOOGLE_POSTMASTER_TOKEN_FILE=/app/data/secrets/token_postmaster.json

# Public URL of this dashboard (needed for Google OAuth redirect)
# Example: https://postmaster.fincovertech.com
PUBLIC_BASE_URL=http://localhost:8080

# Name shown on the login page and sidebar
ADMIN_NAME=Admin

# Persistent data directory (SQLite + secrets). On Render set this to /data
# and attach a disk mounted at /data, otherwise restarts wipe accounts.
DATA_DIR=

# Note: each logged-in user stores Cloudflare/Google secrets in the SQLite DB
# (and mirrored under $DATA_DIR/secrets/users/<user_id>/).
# CLOUDFLARE_API_TOKEN / GOOGLE_* paths are a one-time legacy fallback.
